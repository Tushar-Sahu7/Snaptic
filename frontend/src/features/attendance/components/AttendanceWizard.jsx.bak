import { useState, useEffect, useMemo } from "react";
import { useNavigate } from "react-router";
import { 
  CheckCircle2, 
  RotateCcw, 
  Loader2, 
  Trash2, 
  AlertTriangle,
  Clock,
  ChevronRight,
  ShieldCheck,
  LayoutDashboard,
  Maximize2,
  Scan,
  MoreHorizontal,
  ArrowLeft,
  X,
  AlertCircle,
  Users
} from "lucide-react";
import { Button } from "@/components/ui/button";
import { isWithinSchedule, cn } from "@/lib/utils";
import { ClassIcon } from "@/components/shared/ClassIcon";
import ClassCard from "@/components/shared/ClassCard";
import { 
  AlertDialog,
  AlertDialogAction,
  AlertDialogCancel,
  AlertDialogContent,
  AlertDialogDescription,
  AlertDialogFooter,
  AlertDialogHeader,
  AlertDialogTitle,
} from "@/components/ui/alert-dialog";
import { toast } from "sonner";
import AttendanceRecognitionStep from "./AttendanceRecognitionStep";
import AttendanceReviewStep from "./AttendanceReviewStep";
import { 
  markAttendance, 
  endAttendanceSession,
  submitAttendanceSession,
  reopenAttendanceSession,
  terminateAttendanceSession
} from "@/features/attendance/api/attendance.api";
import { Badge } from "@/components/ui/badge";
import { Avatar, AvatarFallback, AvatarImage } from "@/components/ui/avatar";
import { Card, CardContent } from "@/components/ui/card";
import { CalendarDays } from "lucide-react";

export default function AttendanceWizard({
  session: initialSession,
  students = [],
  profiles = [],
  records = [],
  classes = [],
  todaySessions = {},
  isDirect = false,
  onSelectClass
}) {
  console.log("AttendanceWizard Init - Records Prop:", records);
  console.log("AttendanceWizard Init - Students Prop:", students.map(s => s._id.toString()));
  const navigate = useNavigate();

  // 1. Wizard State
  const [session, setSession] = useState(initialSession);
  const [step, setStep] = useState(() => {
    if (!initialSession) return 1;
    if (initialSession.status === "finalized") return 4;
    if (initialSession.status === "submitted") return 3;

    // Skip to specific steps based on URL flags
    const params = new URLSearchParams(window.location.search);
    if (params.get("manual") === "true") return 3;
    if (params.get("autoStart") === "true") return 2;
    
    // Default resume behavior: go back to scanner if in progress
    if (initialSession.status === "inProgress") return 2;

    return 1;
  });
  const [isTerminating, setIsTerminating] = useState(false);
  const [isFinalized, setIsFinalized] = useState(initialSession?.status === "finalized");
  const [loading, setLoading] = useState(false);
  const [absencesProcessed, setAbsencesProcessed] = useState(initialSession?.status !== "inProgress");

  // 2. Attendance State (Single Source of Truth)
  const [attendanceState, setAttendanceState] = useState(() => {
    const state = {};
    if (records && Array.isArray(records)) {
      records.forEach((r) => {
        // Handle both populated and non-populated studentId
        const sId = typeof r.studentId === "object" ? r.studentId._id?.toString() : r.studentId?.toString();
        if (sId) {
          state[sId] = { status: r.status || "absent", method: r.method || "manual" };
        }
      });
    }
    // Any student not in records should be explicitly known as absent for UI consistency 
    // although the default logic at render or finishScan will handle it.
    console.log("INITIAL ATTENDANCE STATE:", state);
    return state;
  });

  // 3. Real-time Locking Logic
  const [timeLeft, setTimeLeft] = useState("");

  useEffect(() => {
    const checkLock = () => {
      if (isFinalized || !session) return;

      const now = new Date();
      const endTime = session.classId?.schedule?.endTime;
      if (!endTime) return;

      const [eh, em] = endTime.split(":").map(Number);
      const endTotal = eh * 60 + em;
      const currentTotal = now.getHours() * 60 + now.getMinutes();
      const diff = endTotal - currentTotal;

      if (diff <= 0) {
        setIsFinalized(true);
        setStep(4);
        toast.error("Class time has ended. Session finalized.", {
          duration: 5000,
        });
      } else {
        setTimeLeft(`${diff}m left`);
      }
    };

    const interval = setInterval(checkLock, 30000);
    checkLock();
    return () => clearInterval(interval);
  }, [session, isFinalized]);

  // 3.5 Auto-handle Manual Flag
  useEffect(() => {
    const params = new URLSearchParams(window.location.search);
    const isManualMode = params.get("manual") === "true";
    
    // If we are skipping to step 3 manually, we need to ensure backend endSession is called 
    // to populate absences. We check if records are empty or if we just arrived here.
    if (isManualMode && session?.status === "inProgress" && step === 3 && !loading && !absencesProcessed) {
       setAbsencesProcessed(true);
       handleFinishScan();
    }
  }, [step, session?.status, absencesProcessed, loading]);

  // 4. Actions
  const handleMarkManual = async (studentId, status, method = "manual") => {
    if (isFinalized || !session) return;
    const sId = studentId.toString();

    // Optimistic Update
    const prev = attendanceState[sId];
    setAttendanceState((s) => ({ ...s, [sId]: { status, method } }));

    try {
      await markAttendance({
        sessionId: session._id,
        studentId,
        classId: session.classId._id,
        status,
        method,
      });
    } catch (err) {
      // Rollback
      setAttendanceState((s) => ({ ...s, [studentId]: prev }));
      if (err.response?.status === 403) {
        setIsFinalized(true);
        setStep(4);
      }
    }
  };

  const handleFinishScan = async () => {
    if (!session) return;
    setLoading(true);
    try {
      await endAttendanceSession(session._id);

      // Fill in absences for all unrecorded students
      const newState = { ...attendanceState };
      students.forEach((s) => {
        const id = s._id.toString();
        if (!newState[id]) {
          newState[id] = { status: "absent", method: "manual" };
        }
      });
      console.log("FINAL STATE AFTER SCAN:", newState);
      setAttendanceState(newState);
      setStep(3);
    } catch (err) {
      if (err.response?.status === 403) {
        setIsFinalized(true);
        setStep(4);
        toast.error("Class time has ended. Session finalized.");
      } else {
        toast.error("Failed to process absences");
      }
    } finally {
      setLoading(false);
    }
  };

  const handleSubmit = async () => {
    if (!session) return;
    setLoading(true);
    try {
      await submitAttendanceSession(session._id);
      toast.success("Attendance submitted!");
      navigate(`/teacher/classes/${session.classId._id}`, { replace: true });
    } catch (err) {
      toast.error("Failed to submit session");
    } finally {
      setLoading(false);
    }
  };

  const handleBackToScan = async () => {
    if (!session) return;
    if (session.status === "submitted") {
      setLoading(true);
      try {
        const { data } = await reopenAttendanceSession(session._id);
        setSession(data.session);
        setStep(2);
      } catch (err) {
        toast.error("Failed to reopen session for scanning");
      } finally {
        setLoading(false);
      }
    } else {
      setStep(2);
    }
  };

  const handleTerminate = async () => {
    if (!session) return;
    try {
      await terminateAttendanceSession(session._id);
      toast.success("Session terminated");
      navigate(`/teacher/take-attendance`, { replace: true });
    } catch (err) {
      toast.error("Failed to terminate session");
    }
  };

  return (
    <div className="flex flex-col min-h-full bg-background relative z-0">
      {/* 1. Standard Header & Stepper */}
      <div className="shrink-0 border-b bg-card px-4 sm:px-6 py-4 flex flex-col gap-6">
        <div className="flex items-center justify-between">
          <div className="flex items-center gap-3">
            <Button
              variant="ghost"
              size="icon"
              className="rounded-full h-8 w-8 text-muted-foreground hover:text-foreground"
              onClick={() => navigate(-1)}
            >
              <ArrowLeft className="size-4" />
            </Button>
            <div>
              <h2 className="text-sm font-black tracking-tight uppercase">
                {session?.classId?.name || "Ready to Start"}
              </h2>
              <div className="flex items-center gap-2 text-[10px] font-bold text-muted-foreground uppercase tracking-wider">
                <Clock className="size-3" />
                {!session ? "Attendance Phase 1" : isFinalized ? "Session Locked" : `Time Remaining: ${timeLeft}`}
              </div>
            </div>
          </div>

          <div className="flex items-center gap-2">
            {session && !isFinalized && step < 4 && (
              <Button
                variant="ghost"
                size="sm"
                className="text-destructive h-8 px-2 font-bold text-[10px] uppercase hover:bg-destructive/10"
                onClick={() => setIsTerminating(true)}
              >
                <Trash2 className="size-3 mr-1.5" />
                Terminate
              </Button>
            )}
            <div
              className={cn(
                "px-3 py-1 rounded-full border text-[10px] font-bold uppercase tracking-wider",
                isFinalized
                  ? "bg-red-50 text-red-600 border-red-100"
                  : "bg-emerald-50 text-emerald-600 border-emerald-100",
              )}
            >
              {isFinalized ? "Finalized" : "Live"}
            </div>
          </div>
        </div>

        {/* Semantic Stepper */}
        <div className="relative flex justify-between items-center max-w-2xl mx-auto w-full px-2">
          {/* Progress Bar Background */}
          <div className="absolute top-[15px] left-10 right-10 h-[2px] bg-muted z-0" />
          
          {[1, 2, 3, 4].map((s) => {
              const isCompleted = step > s;
              const isActive = step === s;
              const labels = ["Select", "Scan", "Mark", "Review"];
              const isClickable = !isFinalized && step !== s && (
                (s < step) || (s === 2 && step === 3) || (s === 3 && step === 4)
              );

              return (
                <button
                  key={s}
                  disabled={!isClickable}
                  onClick={() => setStep(s)}
                  className={cn(
                    "flex flex-col items-center gap-2 relative transition-all",
                    !isClickable && "cursor-default"
                  )}
                >
                  <div className={cn(
                    "size-8 rounded-full flex items-center justify-center border-2 transition-all duration-300 font-bold text-xs bg-card",
                    isCompleted ? "bg-primary border-primary text-primary-foreground" : 
                    isActive ? "border-primary text-primary ring-4 ring-primary/10" : 
                    "border-muted text-muted-foreground"
                  )}>
                    {isCompleted ? <CheckCircle2 className="size-4" /> : s}
                  </div>
                  <span className={cn(
                    "text-[10px] font-bold uppercase tracking-wider",
                    isActive ? "text-primary" : "text-muted-foreground"
                  )}>
                    {labels[s-1]}
                  </span>
                </button>
              );
            })}
        </div>
      </div>

      {/* 2. Content Area */}
      <main className="flex-1 overflow-y-auto relative p-4 sm:p-6 bg-muted/20">
        {/* Step 1: Selection or Summary */}
        {step === 1 && (
          <div className="h-full flex flex-col items-center">
            {session ? (
              <div className="w-full max-w-xl bg-card border-2 rounded-3xl p-8 shadow-sm space-y-6 mt-12 animate-in fade-in slide-in-from-bottom-4 duration-500">
                  <ClassCard
                    cls={{
                      ...session.classId,
                      studentCount: students.length
                    }}
                    className="cursor-default hover:border-border hover:shadow-sm"
                  />

                <div className="flex flex-col gap-3 w-full">
                  {session.status === "submitted" ? (
                    <Button 
                      onClick={(e) => {
                        e.stopPropagation();
                        setStep(3);
                      }}
                      className="w-full h-14 rounded-2xl font-black text-lg gap-2 shadow-xl shadow-primary/20"
                    >
                      Update Attendance Records
                      <ChevronRight className="size-5" />
                    </Button>
                  ) : (
                    <>
                      <Button 
                        onClick={(e) => {
                          e.stopPropagation();
                          setStep(2);
                        }}
                        className="w-full h-14 rounded-2xl font-black text-lg gap-2 shadow-xl shadow-primary/20"
                      >
                        Start Automatic Recognition
                        <ChevronRight className="size-5" />
                      </Button>
                      
                      <Button 
                        variant="outline"
                        onClick={(e) => {
                          e.stopPropagation();
                          setStep(3);
                        }}
                        className="w-full h-12 rounded-xl font-bold uppercase text-xs tracking-widest gap-2"
                      >
                        Mark Attendance Manually
                        <ArrowLeft className="size-4 rotate-180" />
                      </Button>
                    </>
                  )}
                </div>
              </div>
            ) : (
              <div className="w-full max-w-4xl space-y-8 mt-4">
                <div className="flex flex-col items-center text-center space-y-2">
                  <h2 className="text-xl font-black tracking-tight text-foreground uppercase">Choose a Class</h2>
                  <p className="text-sm text-muted-foreground font-medium">Select an active class to begin the recognition process.</p>
                </div>

                {classes.length === 0 ? (
                  <div className="flex flex-col items-center justify-center py-20 text-center space-y-4 bg-card border-2 rounded-3xl border-dashed">
                    <div className="size-16 rounded-full bg-accent/30 flex items-center justify-center">
                      <CalendarDays className="size-8 text-muted-foreground" />
                    </div>
                    <div>
                      <h3 className="text-lg font-bold">No Active Classes</h3>
                      <p className="text-sm text-muted-foreground">Check your schedule or create a new class first.</p>
                    </div>
                  </div>
                ) : (
                  <div className="grid gap-4 sm:grid-cols-2">
                    {classes.map((c) => {
                      const { onTime, message: scheduleMsg } = isWithinSchedule(c.schedule);
                      const tSession = todaySessions[c._id];
                      const sCount = c.studentIds?.length || 0;
                      const hasActiveSession = tSession?.status === "inProgress";
                      const isSubmitted = tSession?.status === "submitted";
                      const canStart = onTime || hasActiveSession || isSubmitted;

                      return (
                        <ClassCard
                          key={c._id}
                          cls={{
                            ...c,
                            studentCount: sCount
                          }}
                          onClick={() => canStart && onSelectClass?.(c)}
                          className={cn(
                            !canStart && "opacity-60 grayscale border-dashed cursor-not-allowed"
                          )}
                          badge={
                            hasActiveSession ? (
                              <Badge className="bg-amber-500 hover:bg-amber-600 animate-pulse text-[10px] font-bold uppercase tracking-wider">In Progress</Badge>
                            ) : isSubmitted ? (
                              <Badge className="bg-blue-500 hover:bg-blue-600 text-[10px] font-bold uppercase tracking-wider">Submitted</Badge>
                            ) : onTime ? (
                              <Badge className="bg-emerald-500 hover:bg-emerald-600 text-[10px] font-bold uppercase tracking-wider">Live Now</Badge>
                            ) : null
                          }
                          footer={
                            sCount === 0 ? (
                              <div className="flex items-center gap-2 text-amber-600 bg-amber-50 p-3 rounded-2xl border border-amber-100">
                                <AlertCircle className="size-4 shrink-0" />
                                <span className="text-[10px] font-black uppercase tracking-wider">Assign students before starting</span>
                              </div>
                            ) : (
                              <div className="w-full">
                                {isSubmitted && onTime ? (
                                  <Button 
                                    onClick={(e) => {
                                      e.stopPropagation();
                                      onSelectClass?.(c, "manual");
                                    }}
                                    className="w-full rounded-xl font-bold h-12 uppercase text-[11px] tracking-widest gap-2 shadow-sm"
                                  >
                                    Update Attendance
                                    <ChevronRight className="size-4" />
                                  </Button>
                                ) : hasActiveSession ? (
                                  <Button 
                                    onClick={(e) => {
                                      e.stopPropagation();
                                      onSelectClass?.(c);
                                    }}
                                    className="w-full rounded-xl font-bold h-12 uppercase text-[11px] tracking-widest gap-2 shadow-sm"
                                  >
                                    Resume Session
                                    <ChevronRight className="size-4" />
                                  </Button>
                                ) : onTime ? (
                                  <div className="flex flex-col gap-2">
                                    <Button 
                                      variant="default"
                                      onClick={(e) => {
                                        e.stopPropagation();
                                        onSelectClass?.(c, "auto");
                                      }}
                                      className="w-full rounded-xl font-black h-12 uppercase text-[11px] tracking-widest gap-2 shadow-lg"
                                    >
                                      Start Recognition
                                      <Scan className="size-4" />
                                    </Button>
                                    <Button 
                                      variant="outline"
                                      onClick={(e) => {
                                        e.stopPropagation();
                                        onSelectClass?.(c, "manual");
                                      }}
                                      className="w-full rounded-xl font-bold h-10 uppercase text-[10px] tracking-widest gap-2 border-primary/20"
                                    >
                                      Manual Attendance
                                      <Users className="size-3.5" />
                                    </Button>
                                  </div>
                                ) : (
                                  <div className="flex flex-col items-center justify-center p-3 rounded-2xl bg-muted/30 border border-dashed gap-1">
                                    <span className="text-[10px] font-bold text-muted-foreground uppercase tracking-widest leading-none">Off Schedule</span>
                                    {scheduleMsg && (
                                      <span className="text-[9px] font-medium text-muted-foreground/70 uppercase tracking-tighter tabular-nums">
                                        {scheduleMsg}
                                      </span>
                                    )}
                                  </div>
                                )}
                              </div>
                            )
                          }
                        />
                      );
                    })}
                  </div>
                )}
              </div>
            )}
          </div>
        )}

         {/* Step 2: Recognition */}
        {step === 2 && (
          <div className="h-full flex flex-col gap-6 max-w-4xl mx-auto">
            <div className="bg-card border rounded-xl overflow-hidden shadow-sm aspect-video relative">
              <AttendanceRecognitionStep
                students={students}
                profiles={initialSession?.profiles || profiles}
                onMarkPresent={(id) => handleMarkManual(id, "present", "face")}
                onComplete={handleFinishScan}
                sessionData={session}
              />
              <div className="absolute top-4 left-4 flex items-center gap-2 bg-background/80 backdrop-blur px-3 py-1.5 rounded-full border border-border shadow-sm">
                <div className="size-2 bg-emerald-500 rounded-full animate-pulse" />
                <span className="text-[10px] font-bold uppercase tracking-wider">Scanner Active</span>
              </div>
            </div>

            <div className="flex items-center justify-between bg-card p-6 rounded-xl border shadow-sm">
              <div className="flex flex-col">
                <span className="text-sm font-semibold">Automatic Detection</span>
                <span className="text-xs text-muted-foreground">Scanning for faces...</span>
              </div>

              <div className="flex items-center gap-6">
                <div className="text-right">
                  <span className="block text-2xl font-bold tabular-nums">
                    {Object.values(attendanceState).filter(v => v.status === "present").length} 
                    <span className="text-sm text-muted-foreground font-normal ml-1">/ {students.length}</span>
                  </span>
                  <span className="text-[10px] font-bold text-muted-foreground uppercase tracking-widest leading-none">Present</span>
                </div>
                <Button
                  onClick={handleFinishScan}
                  disabled={loading || isFinalized}
                  className="rounded-lg px-6 font-bold"
                >
                  {loading ? <Loader2 className="animate-spin mr-2" /> : null}
                  Next Step
                  <ChevronRight className="size-4 ml-2" />
                </Button>
              </div>
            </div>
          </div>
        )}

         {/* Step 3: Marking */}
        {step === 3 && (
          <div className="max-w-6xl mx-auto space-y-8 pb-12">
            <div className="flex items-center justify-between">
              <div>
                <h3 className="text-xl font-black uppercase tracking-tight">Manual Attendance</h3>
                <p className="text-muted-foreground text-[11px] font-bold uppercase tracking-wider">Tap to toggle presence</p>
              </div>
              <div className="flex items-center gap-3">
                <Button 
                  variant="outline" 
                  size="sm"
                  onClick={handleBackToScan}
                  disabled={loading || isFinalized}
                  className="rounded-xl h-10 font-bold border-2"
                >
                  <RotateCcw className="size-4 mr-2" />
                  Scanner
                </Button>
                <Button
                  onClick={() => setStep(4)}
                  className="rounded-xl h-10 font-bold shadow-lg shadow-primary/10"
                >
                  Confirm Group
                  <ChevronRight className="size-4 ml-2" />
                </Button>
              </div>
            </div>

            <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4">
              {students.map((student) => {
                const sId = student._id.toString();
                const state = attendanceState[sId] || { status: "absent", method: "manual" };
                const isPresent = state.status === "present";
                
                // Lookup name and avatar from profiles array
                const profile = profiles.find(p => p.userId.toString() === student._id.toString());
                const name = profile?.name || student.email?.split("@")[0] || "Student";
                const avatar = profile?.avatar;

                return (
                  <Card
                    key={student._id}
                    disabled={isFinalized || loading}
                    onClick={() => handleMarkManual(
                      student._id, 
                      isPresent ? "absent" : "present", 
                      "manual"
                    )}
                    className={cn(
                      "group relative flex flex-col items-center justify-center p-6 cursor-pointer border-2 transition-all duration-300 hover:shadow-xl hover:shadow-primary/5 active:scale-95 select-none",
                      isPresent 
                        ? "bg-emerald-50/30 border-emerald-500/30 ring-4 ring-emerald-500/5 shadow-sm" 
                        : "bg-white border-border hover:border-primary/20",
                      loading && "opacity-50 pointer-events-none"
                    )}
                  >
                    <Avatar className={cn(
                      "size-20 mb-4 border-2 transition-all duration-300",
                      isPresent ? "border-emerald-500 scale-110 shadow-lg shadow-emerald-500/20" : "border-background shadow-sm"
                    )}>
                      <AvatarImage src={avatar} alt={name} />
                      <AvatarFallback className="text-xl font-bold bg-muted text-muted-foreground uppercase">
                        {name.charAt(0)}
                      </AvatarFallback>
                    </Avatar>

                    <div className="text-center space-y-2 w-full">
                      <p className={cn(
                        "text-xs font-bold truncate px-2 transition-colors",
                        isPresent ? "text-emerald-900" : "text-foreground"
                      )}>
                        {name}
                      </p>
                      
                      <div className="flex justify-center">
                        <Badge variant={isPresent ? "default" : "secondary"} className={cn(
                          "text-[9px] px-2 py-0.5 rounded-full uppercase font-black tracking-widest transition-all",
                          isPresent ? "bg-emerald-500 hover:bg-emerald-500 scale-105 shadow-sm" : "bg-muted text-muted-foreground/30 border-none",
                          !isPresent && "text-muted-foreground/40"
                        )}>
                          {isPresent ? "Present" : "Absent"}
                        </Badge>
                      </div>
                    </div>
                    {isPresent && (
                      <div className="absolute top-2 left-2 px-1.5 py-0.5 rounded-md bg-background/80 backdrop-blur-sm border text-muted-foreground flex items-center gap-1 animate-in fade-in slide-in-from-left-1 duration-300">
                        {state.method === "face" ? (
                          <>
                            <Scan className="size-2.5" />
                            <span className="text-[8px] font-black tracking-tighter uppercase">AI</span>
                          </>
                        ) : (
                          <>
                            <Users className="size-2.5" />
                            <span className="text-[8px] font-black tracking-tighter uppercase">MAN</span>
                          </>
                        )}
                      </div>
                    )}

                    {isPresent && (
                      <div className="absolute top-2 right-2 size-5 rounded-full bg-emerald-500 text-white flex items-center justify-center shadow-lg animate-in zoom-in duration-300">
                        <CheckCircle2 className="size-3 stroke-4" />
                      </div>
                    )}
                  </Card>
                );
              })}
            </div>
          </div>
        )}

        {/* Step 4: Submit & Review */}
        {step === 4 && (
          <div className="max-w-2xl mx-auto space-y-8 pb-12">
            {!isFinalized ? (
              <div className="bg-card border rounded-2xl p-8 space-y-8 shadow-sm">
                <div className="text-center space-y-2">
                  <div className="size-12 rounded-full bg-primary/10 text-primary flex items-center justify-center mx-auto mb-4">
                    <ShieldCheck className="size-6" />
                  </div>
                  <h3 className="text-2xl font-bold tracking-tight">Finalized Review</h3>
                  <p className="text-muted-foreground text-sm">Please verify the summary before submittal.</p>
                </div>

                <div className="grid grid-cols-2 gap-4">
                  <div className="bg-emerald-50 border border-emerald-100 p-4 rounded-xl text-center">
                    <span className="block text-3xl font-bold text-emerald-600">
                      {Object.values(attendanceState).filter(s => s.status === "present").length}
                    </span>
                    <span className="text-[10px] font-bold uppercase tracking-widest text-emerald-700">Present</span>
                  </div>
                  <div className="bg-muted p-4 rounded-xl text-center border">
                    <span className="block text-3xl font-bold text-muted-foreground">
                      {Object.values(attendanceState).filter(s => s.status === "absent").length}
                    </span>
                    <span className="text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Absent</span>
                  </div>
                </div>

                <div className="flex flex-col gap-3">
                  <Button
                    size="lg"
                    onClick={handleSubmit}
                    disabled={loading}
                    className="rounded-xl h-14 font-bold text-base shadow-lg shadow-primary/20"
                  >
                    {loading ? <Loader2 className="animate-spin mr-2" /> : "Submit Attendance"}
                  </Button>
                  <Button
                    variant="ghost"
                    size="lg"
                    onClick={() => setStep(3)}
                    disabled={loading}
                    className="rounded-xl h-12 font-semibold text-muted-foreground"
                  >
                    <ArrowLeft className="size-4 mr-2" />
                    Back to Selection
                  </Button>
                </div>
              </div>
            ) : (
              // Finalized View (Success)
              <div className="space-y-8">
                 <div className="bg-emerald-50 border border-emerald-100 rounded-2xl p-8 flex items-center gap-6 shadow-sm">
                    <div className="size-14 rounded-xl bg-emerald-500 text-white flex items-center justify-center shadow-md">
                       <CheckCircle2 className="size-8" />
                    </div>
                    <div>
                       <h3 className="text-xl font-bold text-emerald-900">Attendance Submitted</h3>
                       <p className="text-emerald-700 text-sm font-medium">All records have been securely locked.</p>
                    </div>
                 </div>
                 
                 <div className="flex justify-center">
                    <Button
                       variant="outline"
                       onClick={() => navigate(`/teacher/classes/${session.classId._id}`)}
                       className="rounded-xl h-12 px-8 font-bold border-2"
                    >
                       Return to Class Details
                    </Button>
                 </div>
              </div>
            )}
          </div>
        )}
      </main>

      {/* Standard Dialogs */}
      <AlertDialog open={isTerminating} onOpenChange={setIsTerminating}>
        <AlertDialogContent className="rounded-[32px] border-2 max-w-sm">
          <AlertDialogHeader>
            <AlertDialogTitle className="text-xl font-black flex items-center gap-2">
              <AlertTriangle className="size-6 text-destructive" />
              Terminate Session?
            </AlertDialogTitle>
            <AlertDialogDescription className="text-sm font-medium leading-relaxed">
              This will permanently delete all records for this session. This action cannot be undone.
            </AlertDialogDescription>
          </AlertDialogHeader>
          <AlertDialogFooter className="flex-col sm:flex-col gap-2 mt-4">
            <AlertDialogAction 
              onClick={handleTerminate}
              className="grow rounded-xl bg-destructive hover:bg-destructive/90 text-destructive-foreground h-12 font-bold w-full uppercase"
            >
              Yes, Terminate Session
            </AlertDialogAction>
            <AlertDialogCancel className="grow rounded-xl border-2 h-12 font-bold w-full mt-0">
              Wait, Keep Session
            </AlertDialogCancel>
          </AlertDialogFooter>
        </AlertDialogContent>
      </AlertDialog>
    </div>
  );
}
